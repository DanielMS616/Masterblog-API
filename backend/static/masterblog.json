{
  "swagger": "2.0",
  "info": {
    "title": "Masterblog API",
    "description": "RESTful API for creating, reading, updating, deleting, searching, and sorting blog posts.",
    "version": "1.0.0"
  },
  "basePath": "/",
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "Post",
      "description": "Operations for managing blog posts"
    }
  ],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Return all blog posts",
        "description": "Returns all posts in their stored order or sorts them by title, content, author, or date.",
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Field used to sort the returned posts",
            "required": false,
            "type": "string",
            "enum": [
              "title",
              "content",
              "author",
              "date"
            ]
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sorting direction. Ascending order is used by default when only sort is provided.",
            "required": false,
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Posts returned successfully",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Post"
              }
            }
          },
          "400": {
            "description": "Invalid sorting field or direction",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "The post data could not be loaded or sorted",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "summary": "Create a new blog post",
        "description": "Creates a new post with an automatically generated integer ID. Title, content, author, and date are required.",
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "post",
            "in": "body",
            "description": "Data for the new blog post",
            "required": true,
            "schema": {
              "$ref": "#/definitions/NewPost"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Post created successfully",
            "schema": {
              "$ref": "#/definitions/Post"
            }
          },
          "400": {
            "description": "Missing fields, invalid JSON, or invalid date",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "The post data could not be loaded or saved",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Search for blog posts",
        "description": "Searches title, content, author, and date for the provided term. The search is case-insensitive.",
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search term used for title, content, author, and date",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Search completed successfully. An empty list is returned when nothing matches.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Post"
              }
            }
          },
          "500": {
            "description": "The post data could not be loaded",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/api/posts/{post_id}": {
      "parameters": [
        {
          "name": "post_id",
          "in": "path",
          "description": "Unique integer ID of the blog post",
          "required": true,
          "type": "integer"
        }
      ],
      "put": {
        "summary": "Update an existing blog post",
        "description": "Updates title, content, author, date, or any combination of these fields. Fields that are not provided keep their current values.",
        "tags": [
          "Post"
        ],
        "parameters": [
          {
            "name": "post",
            "in": "body",
            "description": "Fields that should be updated",
            "required": false,
            "schema": {
              "$ref": "#/definitions/UpdatePost"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post updated successfully",
            "schema": {
              "$ref": "#/definitions/Post"
            }
          },
          "400": {
            "description": "The provided date is invalid",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "No post with the requested ID exists",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "The post data could not be loaded or saved",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an existing blog post",
        "description": "Deletes the post with the requested ID from the JSON storage.",
        "tags": [
          "Post"
        ],
        "responses": {
          "200": {
            "description": "Post deleted successfully",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "404": {
            "description": "No post with the requested ID exists",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "The post data could not be loaded or saved",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Post": {
      "type": "object",
      "required": [
        "id",
        "title",
        "content",
        "author",
        "date"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "title": {
          "type": "string",
          "example": "Learning Flask APIs"
        },
        "content": {
          "type": "string",
          "example": "This post was created through the Masterblog API."
        },
        "author": {
          "type": "string",
          "example": "Daniel"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-07-27"
        }
      }
    },
    "NewPost": {
      "type": "object",
      "required": [
        "title",
        "content",
        "author",
        "date"
      ],
      "properties": {
        "title": {
          "type": "string",
          "example": "My new blog post"
        },
        "content": {
          "type": "string",
          "example": "This is the content of my new blog post."
        },
        "author": {
          "type": "string",
          "example": "Daniel"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-07-27"
        }
      }
    },
    "UpdatePost": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Updated blog post title"
        },
        "content": {
          "type": "string",
          "example": "The content of this post has been updated."
        },
        "author": {
          "type": "string",
          "example": "DanielMS616"
        },
        "date": {
          "type": "string",
          "format": "date",
          "example": "2026-08-01"
        }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Post with id 1 has been deleted successfully."
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Post with id 999 was not found."
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "author",
            "date"
          ]
        }
      }
    }
  }
}